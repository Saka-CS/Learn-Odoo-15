<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="estate_property_user_view_form" model="ir.ui.view">
    <field name="name">res.users.estate.form.inherit</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"></field>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page name="estate" string="Real Estate">
          <field name="estate_property_ids"></field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
