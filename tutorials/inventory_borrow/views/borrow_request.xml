<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="borrow_request_view" model="ir.actions.act_window">
    <field name="name">borrow.request.view</field>
    <field name="res_model">borrow.request</field>
    <field name="view_mode">form,tree</field>
  </record>
  <record id="borrow_request_view_form" model="ir.ui.view">
    <field name="name">borrow.request form</field>
    <field name="model">borrow.request</field>
    <field name="arch" type="xml">
      <form>
        <field name="product_id" />
        <field name="product_tmpl_id" readonly="1" force_save="1" />
        <field name="employee_id" />
        <field name="quantity" />
        <field name="state" />
      </form>
    </field>
  </record>
  <record id="borrow_request_view_tree" model="ir.ui.view">
    <field name="name">borrow.request tree</field>
    <field name="model">borrow.request</field>
    <field name="arch" type="xml">
      <tree>
        <field name="product_id" />
        <field name="employee_id" />
        <field name="quantity" />
        <field name="state" />
      </tree>
    </field>
  </record>
  <record id="view_template_property_form" model="ir.ui.view">
    <field name="name">inventory.borrow.view.form.inherit.stock</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Borrow Item">
          <group>
            <field name="product_tmpl_id" />
            <label string="Borrow Item" for="route_ids" />
            <div>
              <button
                type="action"
                name="%(inventory_borrow.borrow_request_view)d"
                class="btn btn-link pt-0"
                string="View Borrow Form"
                icon="fa-arrow-right"
                context="{'default_product_id': active_id}"
              />
            </div>
          </group>
          <field name="borrow_request_ids">
            <tree>
              <field name="employee_id" />
              <field name="quantity" />
              <field name="state" />
            </tree>
            <form>
              <group>
                <group>
                  <field name="product_id" readonly="1" />
                  <field name="product_tmpl_id" readonly="1" />
                </group>
                <group>
                  <field name="employee_id" />
                  <field name="quantity" />
                  <field name="state" />
                </group>
              </group>
            </form>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
